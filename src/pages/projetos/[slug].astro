---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import { profile } from '../../data/profile';
import { indice, paragrafos, pendente, projetosOrdenados, publicado, url, type Projeto } from '../../lib/site';

export async function getStaticPaths() {
  const projetos = await projetosOrdenados();
  return projetos
    .map((projeto, i) => ({ projeto, numero: i + 1 }))
    .filter(({ projeto }) => publicado(projeto))
    .map(({ projeto, numero }) => ({ params: { slug: projeto.id }, props: { projeto, numero } }));
}

interface Props {
  projeto: Projeto;
  numero: number;
}

const { projeto, numero } = Astro.props;
const p = projeto.data;

const imagens = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/*/*.{png,jpg,jpeg,webp,avif}', {
  eager: true,
});
const galeria = Object.entries(imagens)
  .filter(([caminho]) => caminho.includes(`/projects/${projeto.id}/`))
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([caminho, mod], i) => {
    const nome = caminho
      .split('/')
      .pop()!
      .replace(/\.[^.]+$/, '')
      .replace(/^\d+[-_ ]*/, '')
      .replace(/[-_]+/g, ' ')
      .trim();
    return { src: mod.default, alt: `${p.titulo}: ${nome || `tela ${i + 1}`}` };
  });

const dev = import.meta.env.DEV;
const secoes = [
  { titulo: 'Problema', texto: p.problema, obrigatorio: true },
  { titulo: 'O que fiz', texto: p.oQueFiz, obrigatorio: true },
  { titulo: 'Resultado', texto: p.resultado, obrigatorio: false },
]
  .filter((s) => s.texto !== undefined || s.obrigatorio)
  .map((s) => ({ ...s, pendente: pendente(s.texto) }))
  .filter((s) => !s.pendente || dev);

const links = [
  p.repo && { href: p.repo, label: 'Ver código no GitHub' },
  p.demo && { href: p.demo, label: 'Ver demo' },
].filter(Boolean) as { href: string; label: string }[];

const fichaTecnica = [
  { rotulo: 'Cliente', valor: p.cliente },
  { rotulo: 'Ano', valor: p.ano, num: true },
  { rotulo: 'Stack', valor: p.stack.join(', ') },
];
---

<BaseLayout title={`${p.titulo} — ${profile.nome}`} description={p.descricao}>
  <article class="mx-auto max-w-[1200px] px-6 pt-16 pb-20 md:px-10 md:pt-24 md:pb-28">
    <a
      href={url('#projetos')}
      class="inline-flex min-h-11 items-center text-[15px] text-muted underline decoration-subtle underline-offset-4 transition-colors duration-200 hover:text-text hover:decoration-accent"
    >
      Voltar aos projetos
    </a>

    <header class="mt-10 animate-rise [animation-delay:50ms]">
      <span class="font-num text-[14px] text-accent" aria-hidden="true">{indice(numero)}</span>
      <h1 class="mt-3 max-w-[20ch] text-[40px] leading-[1.05] font-medium tracking-[-0.03em] text-text sm:text-[52px] md:text-[64px]">
        {p.titulo}
      </h1>
      <p class="mt-6 max-w-[54ch] text-[18px] leading-[1.6] text-muted md:text-[21px]">{p.descricao}</p>
    </header>

    <div class="mt-12 grid animate-rise grid-cols-1 items-start gap-8 [animation-delay:180ms] lg:grid-cols-12 lg:gap-14">
      <dl class="divide-y divide-line border-t border-b border-line text-[14px] lg:col-span-7">
        {
          fichaTecnica.map((linha) => (
            <div class="flex justify-between gap-4 px-2 py-3.5">
              <dt class="shrink-0 text-subtle">{linha.rotulo}</dt>
              <dd class:list={['text-right text-text', linha.num && 'font-num']}>{linha.valor}</dd>
            </div>
          ))
        }
      </dl>

      {
        links.length > 0 && (
          <ul class="flex flex-wrap gap-x-8 gap-y-2 text-[15px] lg:col-span-5 lg:pt-2">
            {links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group inline-flex min-h-11 items-center gap-1 text-text transition-colors duration-200 hover:text-accent"
                >
                  {l.label}
                  <span
                    class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                  <span class="sr-only">(abre em nova aba)</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    {
      secoes.length > 0 && (
        <div class="mt-20 divide-y divide-line border-t border-line">
          {secoes.map((s, i) => (
            <section class="reveal grid grid-cols-1 gap-4 py-10 lg:grid-cols-12 lg:gap-6">
              <h2 class="flex items-baseline gap-3 text-[19px] leading-[1.3] font-medium tracking-[-0.01em] text-text lg:col-span-4">
                <span class="font-num text-[13px] text-subtle" aria-hidden="true">
                  {indice(i + 1)}
                </span>
                {s.titulo}
              </h2>
              <div class="max-w-[66ch] space-y-4 lg:col-span-8">
                {s.pendente ? (
                  <p class="border border-dashed border-subtle px-4 py-3 font-num text-[13px] text-muted">
                    {s.texto ?? `TODO: preencher "${s.titulo}"`} (só aparece em desenvolvimento)
                  </p>
                ) : (
                  paragrafos(s.texto!).map((par) => <p class="text-[17px] leading-[1.65] text-text">{par}</p>)
                )}
              </div>
            </section>
          ))}
        </div>
      )
    }

    {
      galeria.length > 0 && (
        <figure class="reveal mt-20 border-t border-line pt-10">
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {galeria.map((img) => (
              <Image
                src={img.src}
                alt={img.alt}
                widths={[480, 720, 960, 1280]}
                sizes="(min-width: 1200px) 548px, (min-width: 768px) 46vw, 100vw"
                class="h-auto w-full border border-line"
              />
            ))}
          </div>
          {p.galeriaLegenda && <figcaption class="mt-4 text-[14px] text-subtle">{p.galeriaLegenda}</figcaption>}
        </figure>
      )
    }

    <div class="mt-20 border-t border-line pt-10">
      <ButtonLink href={url('#projetos')}>Voltar aos projetos</ButtonLink>
    </div>
  </article>
</BaseLayout>
