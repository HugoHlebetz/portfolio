---
import SectionHeader from './SectionHeader.astro';
import { skills } from '../data/skills';
import { indice } from '../lib/site';
---

<section
  id="habilidades"
  aria-labelledby="titulo-habilidades"
  class="reveal mx-auto max-w-[1200px] border-t border-line px-6 py-20 md:px-10"
>
  <SectionHeader index="/04" title="Habilidades" id="titulo-habilidades" />

  <ul class="divide-y divide-line border-t border-b border-line">
    {
      skills.map((s, i) => (
        <li class="group grid grid-cols-1 items-baseline gap-2 px-2 py-6 transition-colors duration-200 hover:bg-surface md:px-4 lg:grid-cols-12 lg:gap-6">
          <span class="font-num text-[13px] text-subtle transition-colors duration-200 group-hover:text-accent lg:col-span-1">
            {indice(i + 1)}
          </span>
          <h3 class="text-[17px] leading-[1.3] font-medium tracking-[-0.01em] text-text transition-colors duration-200 group-hover:text-accent lg:col-span-3">
            {s.grupo}
          </h3>
          <p class="text-[15px] leading-[1.55] text-muted transition-colors duration-200 group-hover:text-text lg:col-span-8">
            {s.itens}
          </p>
        </li>
      ))
    }
  </ul>
</section>
