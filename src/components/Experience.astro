---
import SectionHeader from './SectionHeader.astro';
import { experiences } from '../data/experience';
---

<section
  id="experiencia"
  aria-labelledby="titulo-experiencia"
  class="reveal mx-auto max-w-[1200px] border-t border-line px-6 py-20 md:px-10"
>
  <SectionHeader index="/03" title="Experiência" id="titulo-experiencia" />

  <ol class="divide-y divide-line border-t border-b border-line">
    {
      experiences.map((e) => (
        <li class="group grid grid-cols-1 items-baseline gap-2 px-2 py-8 transition-colors duration-300 ease-out hover:bg-surface md:grid-cols-12 md:gap-6 md:px-4">
          <span
            class:list={[
              'font-num text-[14px] md:col-span-3',
              e.atual ? 'text-accent' : 'text-subtle transition-colors duration-200 group-hover:text-accent',
            ]}
          >
            {e.periodo}
          </span>
          <div class="md:col-span-5">
            <h3 class="text-[17px] leading-[1.3] font-medium tracking-[-0.01em] text-text transition-colors duration-200 group-hover:text-accent">
              {e.cargo}
            </h3>
            <p class="mt-1 text-[14px] leading-[1.55] text-muted transition-colors duration-200 group-hover:text-text">
              {e.descricao}
            </p>
          </div>
          <div class="md:col-span-4 md:text-right">
            <span class="text-[15px] text-text">{e.empresa}</span>
            <span class="block text-[13px] text-subtle">{e.detalheEmpresa}</span>
          </div>
        </li>
      ))
    }
  </ol>
</section>
