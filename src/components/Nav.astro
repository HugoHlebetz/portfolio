---
import { profile } from '../data/profile';
import { url } from '../lib/site';

const links = [
  { href: url('#projetos'), label: 'Projetos' },
  { href: url('#sobre'), label: 'Sobre' },
  { href: url('#experiencia'), label: 'Experiência' },
  { href: url('#contato'), label: 'Contato' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-bg/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-6 md:px-10">
    <a
      href={url()}
      class="text-[17px] font-medium tracking-tight text-text transition-colors duration-200 hover:text-accent"
    >
      {profile.nome}
    </a>

    <nav aria-label="Principal" class="flex items-center gap-4 text-[15px] md:gap-8">
      <ul class="hidden items-center gap-8 md:flex">
        {
          links.map((l) => (
            <li>
              <a class="nav-link text-muted hover:text-text" href={l.href}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="hidden text-line md:inline" aria-hidden="true">|</span>

      <p class="text-[13px] tracking-wider text-muted select-none">
        <span class="font-medium text-text" aria-current="true" lang="pt-BR">PT</span>
        <span aria-hidden="true">/</span>
        <span lang="en" title="English version coming soon">EN</span>
      </p>

      <details class="group md:hidden" data-menu>
        <summary
          class="-mr-3 flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center px-3 text-muted transition-colors hover:text-text [&::-webkit-details-marker]:hidden"
        >
          <span class="group-open:hidden">Menu</span>
          <span class="hidden group-open:inline">Fechar</span>
        </summary>
        <div class="fixed inset-x-0 top-16 border-b border-line bg-bg">
          <ul class="mx-auto max-w-[1200px] divide-y divide-line px-6">
            {
              links.map((l) => (
                <li>
                  <a class="flex min-h-12 items-center text-[17px] text-text hover:text-accent" href={l.href}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </nav>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
